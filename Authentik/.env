# General settings
PUID=1001              # Replace with your user ID
PGID=1001               # Replace with your group ID
DOCKERDIR=/home/tunde/genesis/authentik # Replace with the directory path for your Docker data
DOMAINNAME=oxlava.me   # Replace with your domain name

# PostgreSQL settings
POSTGRES_PASSWORD=mMYzR4sGQMQw8JhJZUPvVyc2qRpBw55S7+q3gVhX   # Replace with your PostgreSQL password
POSTGRES_USER=auth_user           # Replace with your PostgreSQL user
POSTGRES_DB=authentik_db         # Replace with your PostgreSQL database name

# Authentik Redis settings
AUTHENTIK_REDIS__HOST=authentik_redis      # Container name or hostname for Redis

# Authentik PostgreSQL settings
AUTHENTIK_POSTGRESQL__HOST=authentik_postgresql  # Container name or hostname for PostgreSQL
AUTHENTIK_POSTGRESQL__NAME=${POSTGRES_DB}        # PostgreSQL database name
AUTHENTIK_POSTGRESQL__USER=${POSTGRES_USER}      # PostgreSQL user
AUTHENTIK_POSTGRESQL__PASSWORD=${POSTGRES_PASSWORD} # PostgreSQL password

# Authentik general settings
AUTHENTIK_SECRET_KEY=O8rIT5HrlIUxy/v/IExJrYs2eSbMrNrMqhM56axV           # Replace with a strong secret key
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true       # Set to true to disable analytics
AUTHENTIK_DISABLE_UPDATE_CHECK=true            # Set to true to disable update checks
AUTHENTIK_ERROR_REPORTING__ENABLED=false       # Set to false to disable error reporting
AUTHENTIK_LOG_LEVEL=INFO                       # Set log level (e.g., DEBUG, INFO, WARN)
AUTHENTIK_COOKIE_DOMAIN=authentik.oxlava.me        # Set cookie domain

# Email settings
AUTHENTIK_EMAIL__HOST= XXXXXXXXX         # Replace with your SMTP server
AUTHENTIK_EMAIL__PORT=465                     # Replace with your SMTP port
AUTHENTIK_EMAIL__USERNAME=XXXXXX  # Replace with your SMTP username
AUTHENTIK_EMAIL__PASSWORD=XXXXXX  # Replace with your SMTP password
AUTHENTIK_EMAIL__USE_TLS=true                  # Set to true for TLS encryption
AUTHENTIK_EMAIL__USE_SSL=false                 # Set to true for SSL encryption
AUTHENTIK_EMAIL__TIMEOUT=10                    # Timeout for email in seconds
AUTHENTIK_EMAIL__FROM=XXXXXX    # Replace with the "from" email address

# Docker settings
DOCKER_HOST=unix:///var/run/docker.sock
